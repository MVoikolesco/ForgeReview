# Generate a unique AES-256 master key once per environment:
# openssl rand -base64 32
# The backend will not start without this exact base64-encoded 32-byte key.
FORGEREVIEW_ENCRYPTION_KEY=

# Required local authentication bootstrap. The admin password is used only when
# the users table is empty; it is bcrypt-hashed and never stored as plaintext.
FORGEREVIEW_BOOTSTRAP_ADMIN_PASSWORD=
# Generate a distinct value: openssl rand -base64 48
FORGEREVIEW_SESSION_SIGNING_KEY=

# Optional local backend configuration.
# FORGEREVIEW_DATABASE_URL=file:forgereview.db
# FORGEREVIEW_HTTP_ADDR=:8088
# FORGEREVIEW_REDIS_URL=redis://redis:6379/0
