APP_MODE=api
# development uses Next.js hot reload; production builds and runs next start
APP_ENVIRONMENT=production

PORT=8080
SERVICE_NAME=gitea-ai-reviewer
VERSION=0.1.0
LOG_LEVEL=debug

# -------------------------------------------------------------------
# Gitea credentials
# -------------------------------------------------------------------
GITEA_BOT_USERNAME=ia-reviewer
GITEA_URL=your-gitea-url
GITEA_TOKEN=token_do_usuario_ia_reviewer
GITEA_TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-secret-key-value

# Bootstrap/infra only. Review configuration lives in SQLite.
DATABASE_DRIVER=sqlite
DATABASE_DSN=./data/forgereview.db

# Administração web (http://localhost:8088). Troque antes de expor o serviço.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me


# -------------------------------------------------------------------
# Redis Connection
# -------------------------------------------------------------------
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STREAM=gitea:review-jobs
REDIS_GROUP=gitea-reviewers
REDIS_CONSUMER=worker-1

# -------------------------------------------------------------------
# DIFF
# -------------------------------------------------------------------
DIFF_LOG_DIR=/logs/diffs

REVIEW_PLANNER_ENABLED=true
REVIEW_CONSOLIDATOR_ENABLED=true
REVIEW_VERIFIER_ENABLED=true
REVIEW_FORMATTER_ENABLED=true
REVIEW_PLANNER_MAX_OUTPUT_TOKENS=2000
REVIEW_GROUP_MAX_OUTPUT_TOKENS=3500
REVIEW_CONSOLIDATOR_MAX_OUTPUT_TOKENS=3500
REVIEW_VERIFIER_MAX_OUTPUT_TOKENS=2500
REVIEW_FORMATTER_MAX_OUTPUT_TOKENS=2500
REVIEW_CONTEXT_SAFETY_MARGIN_TOKENS=2048
REVIEW_MIN_PUBLISH_CONFIDENCE=0.75
REVIEW_MAX_PARALLEL_GROUPS=1
REVIEW_MEDIUM_SEVERITY_EVENT=REQUEST_CHANGES
REVIEW_PARTIAL_EVENT=COMMENT

# -------------------------------------------------------------------
# Review API/worker defaults
# -------------------------------------------------------------------
REVIEW_MAX_BLOCK_CHARS=2000
REVIEW_MAX_FILES_PER_BLOCK=2
REVIEW_REQUEST_TIMEOUT_SECONDS=900
