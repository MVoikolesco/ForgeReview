# Generate a unique AES-256 master key once per environment:
# openssl rand -base64 32
# The backend will not start without this exact base64-encoded 32-byte key.
FORGEREVIEW_ENCRYPTION_KEY=

# Required local authentication bootstrap. Both values are used only when the
# users table is empty. The email becomes the first admin exactly as written
# (use a trimmed, lowercase address); the password is bcrypt-hashed and never
# stored as plaintext. Changes do not alter existing users.
FORGEREVIEW_BOOTSTRAP_ADMIN_EMAIL=
FORGEREVIEW_BOOTSTRAP_ADMIN_PASSWORD=

# Generate a distinct value: openssl rand -base64 48
FORGEREVIEW_SESSION_SIGNING_KEY=

# Optional local backend configuration.
# FORGEREVIEW_DATABASE_URL=file:forgereview.db
# FORGEREVIEW_HTTP_ADDR=:8088
# FORGEREVIEW_REDIS_URL=redis://redis:6379/0
# Gin uses release mode unless this is exactly "debug".
# FORGEREVIEW_GIN_MODE=debug
# Do not trust forwarded client-address headers by default. Set a comma-separated
# list of only the reverse-proxy IPs/CIDRs that terminate requests when deployed.
# FORGEREVIEW_TRUSTED_PROXIES=10.0.0.10,10.0.0.0/24
# Browser origins allowed to make credentialed API requests. The local Studio
# origin is used when unset; wildcard origins are rejected.
# FORGEREVIEW_CORS_ALLOWED_ORIGINS=http://localhost:3010
