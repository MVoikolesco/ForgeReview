APP_MODE=api

PORT=8080
SERVICE_NAME=gitea-ai-reviewer
VERSION=0.1.0
LOG_LEVEL=debug

# -------------------------------------------------------------------
# Gitea credentials
# -------------------------------------------------------------------
GITEA_BOT_USERNAME=ia-reviewer
GITEA_URL=your-gitea-url
GITEA_TOKEN=token_do_usuario_ia_reviewer

# Bootstrap/infra only. Review configuration lives in SQLite.
DATABASE_DRIVER=sqlite
DATABASE_DSN=./data/forgereview.db

# Administração web (http://localhost:8088). Troque antes de expor o serviço.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me


# -------------------------------------------------------------------
# Redis Connection
# -------------------------------------------------------------------
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STREAM=gitea:review-jobs
REDIS_GROUP=gitea-reviewers
REDIS_CONSUMER=worker-1

# -------------------------------------------------------------------
# DIFF
# -------------------------------------------------------------------
DIFF_LOG_DIR=/logs/diffs

# Provider secrets. Configure only their variable names in the admin panel.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
